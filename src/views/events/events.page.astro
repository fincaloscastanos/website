---
import type { EventsTranslations } from "./events.i18n";
import type { Language } from "@/lib/i18n";
import Container from "@/components/ui/Container.astro";
import Faq from "@/components/ui/Faq.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { Icon } from "astro-icon/components";
import { getTranslatedPath } from "@/lib/registry";

import pattern02 from "@/assets/patterns/pattern-02.svg";
import pattern04 from "@/assets/patterns/pattern-04.svg";
import pattern07 from "@/assets/patterns/pattern-07.svg";

interface Props {
  lang: Language;
  t: EventsTranslations;
}

const { lang, t } = Astro.props;

const contactHref = getTranslatedPath("contact", lang);

const features = [
  { icon: "lucide:users", label: t.features.capacity },
  { icon: "lucide:accessibility", label: t.features.accessible },
  { icon: "lucide:car", label: t.features.parking },
  { icon: "lucide:thermometer", label: t.features.climate },
  { icon: "lucide:wifi", label: t.features.wifi },
  { icon: "lucide:bath", label: t.features.wc },
];
---

<PageHero title={t.hero.title} subtitle={t.hero.subtitle} ctaLabel={t.closing.cta} ctaHref={contactHref} />

<!-- Renovierungshinweis -->
<section class="pt-8 pb-0 bg-background">
  <Container>
    <div
      class="max-w-3xl mx-auto flex gap-4 bg-secondary-light border-l-4 border-secondary p-5 md:p-6 shadow-sm"
      data-animate
      role="note"
    >
      <Icon name="lucide:hammer" class="w-6 h-6 text-brown shrink-0 mt-0.5" />
      <div>
        <p class="text-text-heading font-semibold mb-1">{t.notice.title}</p>
        <p class="text-text leading-relaxed text-sm md:text-base">{t.notice.text}</p>
      </div>
    </div>
  </Container>
</section>

<!-- Intro -->
<section class="pt-10 md:pt-12 pb-16 md:pb-24 bg-background relative overflow-hidden">
  <img src={pattern04.src} alt="" class="absolute top-4 md:-top-4 right-4 md:-right-8 w-40 md:w-56 opacity-[0.09] rotate-12 pointer-events-none select-none" />
  <Container class="relative z-10">
    <div class="max-w-3xl mx-auto space-y-5" data-animate data-speakable>
      <p class="text-text-muted leading-relaxed">{t.intro.p1}</p>
      <p class="text-text-muted leading-relaxed">{t.intro.p2}</p>
    </div>
  </Container>
</section>

<!-- Features -->
<section class="py-16 md:py-24 bg-surface">
  <Container>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {
        features.map(({ icon, label }, i) => (
          <div class="flex items-center gap-3 bg-background rounded-none p-4 shadow-sm" data-animate data-animate-delay={`${i + 1}`}>
            <Icon name={icon} class="w-6 h-6 text-primary shrink-0" />
            <span class="text-text-heading font-medium text-sm">{label}</span>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<!-- Feiern mit Stil -->
<section class="py-16 md:py-24 bg-background relative overflow-hidden">
  <img src={pattern02.src} alt="" class="absolute bottom-4 md:-bottom-6 left-4 md:-left-6 w-24 md:w-36 opacity-[0.10] -rotate-12 pointer-events-none select-none" />
  <img src={pattern07.src} alt="" class="absolute top-8 right-4 md:-right-6 w-28 md:w-40 opacity-[0.10] rotate-6 pointer-events-none select-none" />
  <Container class="relative z-10">
    <div class="max-w-3xl mx-auto" data-animate>
      <h2
        class="text-xl md:text-2xl mb-2 font-sans uppercase tracking-wider font-light"
      >
        {t.style.title}
      </h2>
      <p class="font-serif text-accent text-2xl md:text-3xl mb-3">
        {t.style.subtitle}
      </p>
      <div class="space-y-5">
        <p class="text-text-muted leading-relaxed">{t.style.p1}</p>
        <p class="text-text-muted leading-relaxed">{t.style.p2}</p>
      </div>
    </div>
  </Container>
</section>

<!-- FAQ -->
<Faq title={t.faq.title} subtitle={t.faq.subtitle} items={t.faq.items} />

<!-- EventVenue Schema -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EventVenue",
  name: lang === "de" ? "Eventzelt Finca Los Castaños" : lang === "en" ? "Event Tent Finca Los Castaños" : "Carpa de Eventos Finca Los Castaños",
  description: lang === "de"
    ? "Eventzelt für bis zu 75 Personen auf der Kaffeeplantage im Valle de Agaete, Gran Canaria."
    : lang === "en"
    ? "Event tent for up to 75 guests on the coffee plantation in the Valle de Agaete, Gran Canaria."
    : "Carpa para hasta 75 personas en la plantación de café del Valle de Agaete, Gran Canaria.",
  maximumAttendeeCapacity: 75,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Camino de Los Romeros S/N",
    addressLocality: "Agaete",
    postalCode: "35489",
    addressRegion: "Las Palmas",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 28.0810937,
    longitude: -15.6731384,
  },
  telephone: "+34 682 64 45 41",
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "Barrier-free access", value: true },
    { "@type": "LocationFeatureSpecification", name: "Parking", value: true },
    { "@type": "LocationFeatureSpecification", name: "Air conditioning", value: true },
    { "@type": "LocationFeatureSpecification", name: "Heating", value: true },
    { "@type": "LocationFeatureSpecification", name: "WiFi", value: true },
    { "@type": "LocationFeatureSpecification", name: "Sanitary facilities", value: true },
  ],
})} />

<!-- CTA -->
<section class="py-16 md:py-24 bg-accent relative overflow-hidden">
  <div
    class="absolute inset-0 bg-repeat opacity-10" style={`background-image: url(${pattern04.src})`}
  >
  </div>
  <Container class="relative z-10">
    <div class="max-w-3xl mx-auto text-center" data-animate>
      <p class="text-xl md:text-2xl text-text leading-relaxed mb-8">
        {t.closing.text}
      </p>
      <a
        href={contactHref}
        class="inline-flex items-center gap-2 bg-white text-text-heading font-bold py-3 px-8 rounded-none hover:bg-white/80 transition-colors duration-300 shadow-lg"
      >
        {t.closing.cta}
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </Container>
</section>
