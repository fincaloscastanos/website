---
import type { JobsTranslations } from "./jobs.i18n";
import type { Language } from "@/lib/i18n";
import Container from "@/components/ui/Container.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { Icon } from "astro-icon/components";
import { siteData } from "@/data/site";

import pattern02 from "@/assets/patterns/pattern-02.svg";
import pattern06 from "@/assets/patterns/pattern-06.svg";

interface Props {
  lang: Language;
  t: JobsTranslations;
}

const { t } = Astro.props;

const positions = [
  { icon: "lucide:calculator", ...t.positions.admin },
  { icon: "lucide:compass", ...t.positions.guide },
  { icon: "lucide:coffee", ...t.positions.service },
];

const mailtoHref = `mailto:${siteData.contact.jobsEmail}?subject=${encodeURIComponent(t.apply.mailSubject)}`;
---

<PageHero title={t.hero.title} subtitle={t.hero.subtitle} />

<!-- Open positions -->
<section class="py-16 md:py-24 bg-background relative overflow-hidden">
  <img
    src={pattern02.src}
    alt=""
    class="absolute top-4 md:-top-6 right-4 md:-right-8 w-40 md:w-56 opacity-[0.09] rotate-12 pointer-events-none select-none"
  />
  <img
    src={pattern06.src}
    alt=""
    class="absolute bottom-4 md:-bottom-6 left-4 md:-left-6 w-28 md:w-36 opacity-[0.10] rotate-[-15deg] pointer-events-none select-none"
  />
  <Container class="relative z-10">
    <p
      class="max-w-3xl mx-auto text-center text-base md:text-lg text-text-muted leading-relaxed mb-10 md:mb-14"
      data-animate
    >
      {t.intro}
    </p>

    <div class="max-w-3xl mx-auto flex flex-col gap-4">
      {
        positions.map((position, index) => (
          <article
            class="flex items-start gap-4 p-5 md:p-6 bg-surface border border-border/50 rounded-none"
            data-animate
            data-animate-delay={index + 1}
          >
            <div class="w-10 h-10 rounded-none bg-primary/10 flex items-center justify-center shrink-0">
              <Icon name={position.icon} class="w-5 h-5 text-primary" />
            </div>
            <div>
              <h2 class="font-sans uppercase tracking-wider font-light text-base md:text-lg text-text-heading">
                {position.title}
              </h2>
              {position.type && (
                <span class="block text-xs uppercase tracking-widest text-accent font-medium mt-1">
                  {position.type}
                </span>
              )}
              {position.description && (
                <p class="text-base text-text-muted leading-relaxed mt-3">
                  {position.description}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<!-- Apply -->
<section class="py-16 md:py-20 bg-accent text-white">
  <Container>
    <div class="max-w-2xl mx-auto text-center" data-animate>
      <h2
        class="font-sans uppercase tracking-wider font-light text-xl md:text-2xl mb-3"
      >
        {t.apply.title}
      </h2>
      <p class="text-base md:text-lg text-white/90 leading-relaxed mb-6">
        {t.apply.text}
      </p>
      <a
        href={mailtoHref}
        class="inline-flex items-center gap-2 bg-secondary text-text-heading text-sm font-bold py-3 px-8 rounded-none hover:bg-secondary-dark transition-colors duration-300 shadow-lg"
      >
        <Icon name="lucide:mail" class="w-4 h-4" />
        {t.apply.cta}
      </a>
    </div>
  </Container>
</section>
